{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexchat",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,

  "vars": {
    "ENVIRONMENT": "production"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "NEXCHAT_ROOM",
        "class_name": "NexChatRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NexChatRoom"
      ]
    }
  ]
}