{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexchat",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "vars": {
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "NexChat <noreply@YOUR_VERIFIED_DOMAIN>",
    "EMAIL_VERIFICATION_URL": "https://nexchat-sites.vercel.app/verify-email",
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "NEXCHAT_ROOM",
        "class_name": "NexChatRoom",
      },
    ],
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NexChatRoom"],
    },
  ],
}
